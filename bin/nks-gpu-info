#!/usr/bin/env bash
set -euo pipefail

echo "=== NKS GPU profile ==="
cat "${XDG_CACHE_HOME:-$HOME/.cache}/nekoroshell/gpu-profile" 2>/dev/null || echo "unknown"
echo
echo "=== GPU devices ==="
lspci -nnk 2>/dev/null | grep -EA4 'VGA compatible controller|3D controller|Display controller' || true
echo
echo "=== NVIDIA DRM ==="
if [[ -r /sys/module/nvidia_drm/parameters/modeset ]]; then
    printf 'modeset='; cat /sys/module/nvidia_drm/parameters/modeset
fi
if [[ -r /sys/module/nvidia_drm/parameters/fbdev ]]; then
    printf 'fbdev='; cat /sys/module/nvidia_drm/parameters/fbdev
fi
echo
echo "=== Vulkan devices ==="
if command -v vulkaninfo >/dev/null 2>&1; then
    vulkaninfo --summary 2>/dev/null || true
fi
